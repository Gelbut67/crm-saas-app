# Base de données Supabase
DATABASE_URL="postgresql://postgres:[VOTRE_MOT_DE_PASSE]@db.[VOTRE_PROJET].supabase.co:5432/postgres"

# Grok (xAI) pour l'optimisation de tournées
# Obtenez votre clé sur: https://console.x.ai
XAI_API_KEY="votre-cle-api-xai"
# Modèle Grok (optionnel, défaut: grok-4.3)
# GROK_MODEL="grok-4.3"

# NextAuth - Authentification
# Générez un secret avec: openssl rand -base64 32
NEXTAUTH_SECRET="votre-secret-nextauth-tres-long-et-aleatoire"
NEXTAUTH_URL="http://localhost:3000"
