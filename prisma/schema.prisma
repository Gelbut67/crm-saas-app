// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id               String    @id @default(cuid())
  nom              String
  email            String?
  telephone        String?
  telephoneFixe    String?
  telephonePortable String?
  entreprise       String?
  secteur          String?
  adresse          String?
  codePostal       String?
  ville            String?
  departement      String?
  statut           String    @default("prospect") // prospect, client
  dateCreation     DateTime  @default(now())
  caTotal          Float     @default(0)
  
  contacts      Contact[]
  interactions  Interaction[]
  devis         Devis[]
  
  @@map("clients")
}

model Contact {
  id               String   @id @default(cuid())
  clientId         String
  nom              String
  email            String?
  telephone        String?
  telephoneFixe    String?
  telephonePortable String?
  poste            String?
  isPrincipal      Boolean  @default(false)
  dateCreation     DateTime @default(now())
  
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  @@map("contacts")
}

model Interaction {
  id        String   @id @default(cuid())
  clientId  String
  type      String   // appel, rdv, note, email
  contenu   String
  date      DateTime @default(now())
  
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  @@map("interactions")
}

model Devis {
  id           String   @id @default(cuid())
  clientId     String
  titre        String
  montant      Float
  statut       String   // en_cours, gagne, perdu
  dateEcheance DateTime
  description  String?
  dateCreation DateTime @default(now())
  
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  piecesJointes PieceJointe[]
  
  @@map("devis")
}

model PieceJointe {
  id           String   @id @default(cuid())
  devisId      String
  nomFichier   String
  urlFichier   String
  typeFichier  String?
  tailleFichier Int?
  dateAjout    DateTime @default(now())
  
  devis        Devis    @relation(fields: [devisId], references: [id], onDelete: Cascade)
  
  @@map("pieces_jointes")
}

model Settings {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String
  dateModification DateTime @default(now()) @updatedAt
  
  @@map("settings")
}
