// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  nom          String
  email        String   @unique
  password     String
  role               String   @default("commercial") // commercial, admin
  mustChangePassword Boolean  @default(false)
  dateCreation       DateTime @default(now())

  clients      Client[]
  settings      Settings[]
  reminders    Reminder[]
  tournees     Tournee[]
  emailAccounts EmailAccount[]
  emailCampaigns EmailCampaign[]
  weeklyObjectives WeeklyObjective[]

  @@map("users")
}

model Client {
  id               String    @id @default(cuid())
  nom              String
  email            String?
  telephone        String?
  telephoneFixe    String?
  telephonePortable String?
  entreprise       String?
  secteur          String?
  adresse          String?
  codePostal       String?
  ville            String?
  departement      String?
  statut           String    @default("prospect") // prospect, client
  dateCreation     DateTime  @default(now())
  lat              Float?
  lon              Float?
  caTotal          Float     @default(0)
  userId           String?
  user             User?     @relation(fields: [userId], references: [id])
  
  contacts       Contact[]
  interactions   Interaction[]
  devis          Devis[]
  reminders      Reminder[]
  tourneeVisites TourneeVisite[]
  emailLogs      EmailLog[]
  campaignRecipients CampaignRecipient[]
  weeklyObjectiveItems WeeklyObjectiveItem[]
  
  @@map("clients")
}

model Contact {
  id               String   @id @default(cuid())
  clientId         String
  nom              String
  email            String?
  telephone        String?
  telephoneFixe    String?
  telephonePortable String?
  poste            String?
  isPrincipal      Boolean  @default(false)
  dateCreation     DateTime @default(now())
  
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  @@map("contacts")
}

model Interaction {
  id        String   @id @default(cuid())
  clientId  String
  type      String   // appel, rdv, note, email
  contenu   String
  date      DateTime @default(now())
  
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  @@map("interactions")
}

model Devis {
  id                 String   @id @default(cuid())
  clientId           String
  titre              String
  montant            Float
  statut             String   // en_cours, gagne, perdu
  dateEcheance       DateTime
  description        String?
  dateCreation       DateTime @default(now())
  numero             String?
  objet              String?
  civilite           String?
  lignes             String?
  delai              String?
  livraison          String?
  conditionsPaiement String?
  validite           String?
  nomContact         String?
  afficherTotaux     Boolean  @default(true)
  
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  piecesJointes PieceJointe[]
  
  @@map("devis")
}

model PieceJointe {
  id           String   @id @default(cuid())
  devisId      String
  nomFichier   String
  urlFichier   String
  typeFichier  String?
  tailleFichier Int?
  dateAjout    DateTime @default(now())
  
  devis        Devis    @relation(fields: [devisId], references: [id], onDelete: Cascade)
  
  @@map("pieces_jointes")
}

model Reminder {
  id              String   @id @default(cuid())
  titre           String
  contenu         String?
  echeance        DateTime
  notificationsAt String?
  fait            Boolean  @default(false)
  clientId        String?
  userId          String
  dateCreation    DateTime @default(now())

  client       Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

model Settings {
  id              String   @id @default(cuid())
  key             String
  value           String
  userId          String
  dateModification DateTime @default(now()) @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([key, userId])
  @@map("settings")
}

model Tournee {
  id        String          @id @default(cuid())
  date      DateTime        @default(now())
  nom       String?
  statut    String          @default("planifiee")
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  visites   TourneeVisite[]
  createdAt DateTime        @default(now())

  @@map("tournees")
}

model TourneeVisite {
  id            String   @id @default(cuid())
  tourneeId     String
  tournee       Tournee  @relation(fields: [tourneeId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  heureArrivee  String?
  heureDepart   String?
  ordre         Int      @default(0)
  visite        Boolean  @default(false)
  interactionId String?
  createdAt     DateTime @default(now())

  @@map("tournee_visites")
}

model EmailAccount {
  id          String    @id @default(cuid())
  userId      String
  label       String
  fromEmail   String
  fromName    String?
  smtpHost    String
  smtpPort    Int
  smtpUser    String
  smtpPass    String
  smtpSecure  Boolean   @default(true)
  imapHost    String?
  imapPort    Int?
  imapUser    String?
  imapPass    String?
  imapSecure  Boolean?  @default(true)
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  emails      EmailLog[]
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_accounts")
}

model EmailLog {
  id            String        @id @default(cuid())
  userId        String
  accountId     String?
  clientId      String?
  contactId     String?
  campaignId    String?
  externalId    String?       // id/messageId du serveur IMAP
  direction     String        // outbound, inbound
  subject       String
  body          String        @db.Text
  to            String
  fromEmail     String
  status        String        @default("draft") // draft, sent, received, failed
  aiGenerated   Boolean       @default(false)
  aiPrompt      String?       @db.Text
  errorMessage  String?
  sentAt        DateTime?
  createdAt     DateTime      @default(now())

  account       EmailAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  client        Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  campaign      EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@map("email_logs")
}

model EmailCampaign {
  id            String    @id @default(cuid())
  userId        String
  name          String
  subject       String
  prompt        String    @db.Text
  status        String    @default("draft") // draft, sending, sent, paused
  total         Int       @default(0)
  sent          Int       @default(0)
  failed        Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sentAt        DateTime?

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipients    CampaignRecipient[]
  emails        EmailLog[]

  @@map("email_campaigns")
}

model CampaignRecipient {
  id          String   @id @default(cuid())
  campaignId  String
  clientId    String
  email       String
  status      String   @default("pending") // pending, sent, failed, skipped
  sentAt      DateTime?
  error       String?

  campaign    EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("campaign_recipients")
}

model WeeklyObjective {
  id        String   @id @default(cuid())
  userId    String
  weekStart DateTime // Lundi 00:00 de la semaine concernée
  createdAt DateTime @default(now())

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WeeklyObjectiveItem[]

  @@unique([userId, weekStart])
  @@map("weekly_objectives")
}

model WeeklyObjectiveItem {
  id            String    @id @default(cuid())
  objectiveId   String
  clientId      String
  visite        Boolean   @default(false)
  visitedAt     DateTime?
  interactionId String?
  reporte       Boolean   @default(false) // true si reporté d'une semaine précédente
  createdAt     DateTime  @default(now())

  objective     WeeklyObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  client        Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([objectiveId, clientId])
  @@map("weekly_objective_items")
}
