// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  nom          String
  email        String   @unique
  password     String
  role               String   @default("commercial") // commercial, admin
  mustChangePassword Boolean  @default(false)
  dateCreation       DateTime @default(now())

  clients      Client[]
  settings      Settings[]
  reminders    Reminder[]
  tournees     Tournee[]

  @@map("users")
}

model Client {
  id               String    @id @default(cuid())
  nom              String
  email            String?
  telephone        String?
  telephoneFixe    String?
  telephonePortable String?
  entreprise       String?
  secteur          String?
  adresse          String?
  codePostal       String?
  ville            String?
  departement      String?
  statut           String    @default("prospect") // prospect, client
  dateCreation     DateTime  @default(now())
  lat              Float?
  lon              Float?
  caTotal          Float     @default(0)
  userId           String?
  user             User?     @relation(fields: [userId], references: [id])
  
  contacts       Contact[]
  interactions   Interaction[]
  devis          Devis[]
  reminders      Reminder[]
  tourneeVisites TourneeVisite[]
  
  @@map("clients")
}

model Contact {
  id               String   @id @default(cuid())
  clientId         String
  nom              String
  email            String?
  telephone        String?
  telephoneFixe    String?
  telephonePortable String?
  poste            String?
  isPrincipal      Boolean  @default(false)
  dateCreation     DateTime @default(now())
  
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  @@map("contacts")
}

model Interaction {
  id        String   @id @default(cuid())
  clientId  String
  type      String   // appel, rdv, note, email
  contenu   String
  date      DateTime @default(now())
  
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  @@map("interactions")
}

model Devis {
  id                 String   @id @default(cuid())
  clientId           String
  titre              String
  montant            Float
  statut             String   // en_cours, gagne, perdu
  dateEcheance       DateTime
  description        String?
  dateCreation       DateTime @default(now())
  numero             String?
  objet              String?
  civilite           String?
  lignes             String?
  delai              String?
  livraison          String?
  conditionsPaiement String?
  validite           String?
  afficherTotaux     Boolean  @default(true)
  
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  piecesJointes PieceJointe[]
  
  @@map("devis")
}

model PieceJointe {
  id           String   @id @default(cuid())
  devisId      String
  nomFichier   String
  urlFichier   String
  typeFichier  String?
  tailleFichier Int?
  dateAjout    DateTime @default(now())
  
  devis        Devis    @relation(fields: [devisId], references: [id], onDelete: Cascade)
  
  @@map("pieces_jointes")
}

model Reminder {
  id              String   @id @default(cuid())
  titre           String
  contenu         String?
  echeance        DateTime
  notificationsAt String?
  fait            Boolean  @default(false)
  clientId        String?
  userId          String
  dateCreation    DateTime @default(now())

  client       Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

model Settings {
  id              String   @id @default(cuid())
  key             String
  value           String
  userId          String
  dateModification DateTime @default(now()) @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([key, userId])
  @@map("settings")
}

model Tournee {
  id        String          @id @default(cuid())
  date      DateTime        @default(now())
  nom       String?
  statut    String          @default("planifiee")
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  visites   TourneeVisite[]
  createdAt DateTime        @default(now())

  @@map("tournees")
}

model TourneeVisite {
  id            String   @id @default(cuid())
  tourneeId     String
  tournee       Tournee  @relation(fields: [tourneeId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  heureArrivee  String?
  heureDepart   String?
  ordre         Int      @default(0)
  visite        Boolean  @default(false)
  interactionId String?
  createdAt     DateTime @default(now())

  @@map("tournee_visites")
}
